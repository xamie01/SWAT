[Unit]
Description=SWAT / WAKE API Gateway
After=network.target postgresql.service redis.service pgbouncer.service
Wants=redis.service pgbouncer.service

[Service]
Type=simple
User=swat
WorkingDirectory=/root/SWAT
Environment=NODE_ENV=production
EnvironmentFile=/root/SWAT/.env
ExecStart=/usr/bin/node /root/SWAT/apps/api/dist/index.js
Restart=always
RestartSec=5
LimitNOFILE=65536

# Sandboxing and security hardening
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
