# ==============================================================================
# SWAT / WAKE Production Cron Schedule (alternative to the billing systemd timer)
# ==============================================================================
# Install for the unprivileged swat user; do not also enable the billing timer.
# /opt/swat/current is a root-owned, swat-readable immutable release outside homes.
# The operator provisions /var/log/swat writable by swat (0700).
# /etc/swat/pg_service.conf: root:swat 0640 (non-secret connection settings).
# /etc/swat/pgpass: swat:swat 0600; libpq rejects group/other access.
# Never put passwords/URLs in a crontab or argv.
# swat-maintenance must be a separately reviewed least-privilege database role.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=""
PGSERVICEFILE=/etc/swat/pg_service.conf
PGPASSFILE=/etc/swat/pgpass
PGSERVICE=swat-maintenance

# Prefer swat-billing-sweep.timer: systemd loads its scoped EnvironmentFile safely.
# Cron billing is intentionally omitted: do not source an environment file as shell.

# Daily Database Vacuum & Analyze (03:00 UTC)
0 3 * * * /usr/bin/psql --no-password -c "VACUUM ANALYZE;" >> /var/log/swat/db-vacuum.log 2>&1

# Optional privileged statistics reset is omitted from the application-user schedule.
