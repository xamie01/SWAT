# ==============================================================================
# SWAT / WAKE Production Cron Schedule
# ==============================================================================
# Run as the swat system user or install via `crontab -e -u swat`
#
# Environment settings
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=""

# 1. Daily Subscription Tier Downgrade Sweep (Midnight UTC)
# Downgrades expired paid subscriptions (Operator / Ultra) back to 'free' and writes audit log.
0 0 * * * cd /root/SWAT && /usr/bin/node apps/api/dist/cron/billing-sweep.js >> /var/log/swat/billing-sweep.log 2>&1

# 2. Daily Database Vacuum & Analyze (03:00 UTC)
0 3 * * * /usr/bin/psql "postgresql://swat:swat@127.0.0.1:5432/swat" -c "VACUUM ANALYZE;" >> /var/log/swat/db-vacuum.log 2>&1

# 3. Weekly pg_stat_statements reset (Sunday 04:00 UTC)
0 4 * * 0 /usr/bin/psql "postgresql://swat:swat@127.0.0.1:5432/swat" -c "SELECT pg_stat_statements_reset();" >> /dev/null 2>&1
