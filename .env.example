# ══════════════════════════════════════════════════════════════════════════════
# SWAT Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in the values before running any service.
# This is the authoritative environment-variable reference for the repository.
# ══════════════════════════════════════════════════════════════════════════════

# ── Infrastructure ────────────────────────────────────────────────────────────
# Framework commands set NODE_ENV for local development/builds. Production
# launchers must set it explicitly; the API then rejects its development key.
# NODE_ENV=production

# Compose database settings. Keep DATABASE_URL aligned with POSTGRES_PORT.
POSTGRES_DB=swat
POSTGRES_USER=swat
POSTGRES_PASSWORD=swat
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432

# Required by: backend services that import @swat/db
DATABASE_URL=postgresql://swat:swat@localhost:5432/swat

# Optional read replica. When unset (or equal to DATABASE_URL) no second pool is
# opened and reads share the primary. Only `readQuery()` uses it — `query()`
# always goes to the primary, because most call sites in @swat/db are writes.
# DATABASE_READ_URL=postgresql://swat:swat@replica:5432/swat

# PostgreSQL pool limits and failure bounds. Invalid values fail fast.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=60000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
DB_SHUTDOWN_TIMEOUT_MS=10000

# Compose Redis settings. Keep REDIS_URL aligned with REDIS_PORT.
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6379

# Required by: api, indexer, signal-engine, alert-service, trade-executor, discovery, scorer, mcp-server
REDIS_URL=redis://localhost:6379

# ── Ports ─────────────────────────────────────────────────────────────────────
# Used by: apps/api (default: 3001)
PORT=3001

# Used by: apps/indexer webhook server (default: 3002)
WEBHOOK_PORT=3002

# Used by: apps/mcp-server (default: 3005)
MCP_PORT=3005

# Used by: apps/web (Next.js frontend)
WEB_BIND_HOST=0.0.0.0
WEB_HOST=localhost
WEB_PORT=3000

# Optional path used by start.sh to track the exact development process.
SWAT_PID_FILE=.swat-dev.pid

# API base URL for server-side fetches. Falls back to http://localhost:3001.
# In production, set to your public API URL (e.g., https://api.yoursite.com)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional API CORS allowlist. Empty uses the API's local-development policy.
CORS_ORIGIN=

# ── Security ──────────────────────────────────────────────────────────────────
# ⚠️ CHANGE THIS before going live.
# Used by: apps/api — all routes require X-Api-Key: <this value>
API_KEY=swat-dev-key

# Exposed to the frontend to authorize API requests
NEXT_PUBLIC_API_KEY=swat-dev-key

# ── Helius (Solana RPC + Webhooks) ────────────────────────────────────────────
# ✅ REQUIRED for the system to function.
# Used by: apps/indexer (backfill), apps/signal-engine (live safety checks)
# Get your key at: https://helius.dev → Dashboard → API Keys
HELIUS_API_KEY=

# Optional — only required if you register a real-time webhook in Helius.
# Used by: apps/indexer/src/webhook.ts as the exact Helius authHeader value.
# Must match the authHeader configured for the webhook. Leave empty to disable
# the endpoint; requests fail closed when this is not configured.
HELIUS_WEBHOOK_SECRET=

# ── Telegram Alerts ───────────────────────────────────────────────────────────
# ✅ REQUIRED to receive trade alerts.
# Get token from @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=

# Your Telegram chat or group ID.
# Find it: message @userinfobot, or add @RawDataBot to your group.
TELEGRAM_CHAT_ID=

# Interval between ingestion-health checks by apps/alert-service. Values below
# 10 seconds or above 15 minutes are clamped; 60 seconds is the default.
INGESTION_HEALTH_POLL_MS=60000

# ── Transactional Email (Resend) ───────────────────────────────────────────────
# Required before withdrawal confirmation (S4-12) can be enabled. Telegram is not
# a substitute: that channel is the operator's, so it proves nothing about the
# user's control of their own mailbox.
# Consumed by: packages/shared/src/email.ts (server-side only).
#
# Resend API key, from resend.com → API Keys. ⚠️ Secret — it carries send
# authority on your verified domain. Never mirror it into a NEXT_PUBLIC_* name;
# those are inlined into the client bundle and shipped to every visitor.
# Unset means every send returns not_sent/not-configured, which fails closed:
# a withdrawal stays unconfirmed and expires rather than proceeding without
# proof the confirmation reached the user's mailbox.
RESEND_API_KEY=

# Sender address. Plain `user@domain` or `Name <user@domain>`. The domain must be
# verified in Resend or every send is rejected with `validation_error`.
EMAIL_FROM=SWAT <no-reply@example.com>

# Optional Reply-To. Leave empty to omit the header entirely.
EMAIL_REPLY_TO=

# API base URL. Override only to route through an egress proxy or a test double.
# A trailing slash is stripped before use.
RESEND_API_BASE_URL=https://api.resend.com

# Per-send timeout. Clamped to 1000–60000 ms; invalid or empty falls back to
# 10000. A too-short value makes every send report an ambiguous timeout, and an
# ambiguous send is treated as undelivered.
EMAIL_SEND_TIMEOUT_MS=10000

# ── Execution Bot ─────────────────────────────────────────────────────────────
# Required for Solana live execution through Trojan. TROJAN_WALLET_ADDRESS must
# be the exact wallet used by the configured bot so SWAT can verify its balance.
TROJAN_WEBHOOK_URL=
TROJAN_API_KEY=
TROJAN_WALLET_ADDRESS=

# Native balance retained instead of being offered as trade value.
SOLANA_GAS_RESERVE_SOL=0.01

# ── Jupiter Swap API (Paper-Trade Simulation) ─────────────────────────────
# Used by: apps/trade-executor (paper-trade quote simulation)
# Get your free key at: https://developers.jup.ag/portal
# When set, paper trades fetch a real Jupiter swap quote to get accurate
# output amounts, price impact, and routing — instead of a naive spot-price
# division.  The system works without this key, but paper trades won't have
# AMM-routed accuracy.  No SOL or wallet required — quotes are read-only.
JUPITER_API_KEY=
JUPITER_QUOTE_TIMEOUT_MS=8000

# Which Solana executor carries a live trade: 'trojan' (default) or 'jupiter-jito'.
#
# Jupiter+Jito is built and unit-tested but NOT certified — checklist S3-9 requires
# a capped live canary recorded under docs/certification/solana.md first. Leaving
# this unset keeps the incumbent certified path. A typo throws at startup rather
# than falling back, so a misrouted execution variable cannot fail silently.
#
# Setting this alone is not sufficient: a signer (SOLANA_PRIVATE_KEY) and a block
# engine (JITO_BLOCK_ENGINE_URL) must also be configured, and LIVE_ENABLED_CHAINS
# plus an active chain_certifications row still gate live mode on top.
SOLANA_EXECUTOR=

# ─── Solana live execution: Jupiter + Jito (DG-1) ───────────────────────────
# Replaces the Trojan webhook path. Both remain wired until the new path is
# certified (checklist S3-6); `resolveChainMode` accepts either being ready and
# clamps Solana to paper when neither is.
#
# Base58-encoded 64-byte secret key. Absent = Solana cannot execute live, which
# is the correct default: a paper-mode box must not hold a signing key.
SOLANA_PRIVATE_KEY=
# Defaults to the Helius endpoint derived from HELIUS_API_KEY when unset.
SOLANA_RPC_URL=
# Jito block-engine base URL, e.g. https://mainnet.block-engine.jito.wtf
# Deliberately has NO default: a wrong URL fails every bundle at submit time,
# and guessing one turns a config omission into a runtime mystery.
JITO_BLOCK_ENGINE_URL=
# Optional block-engine auth key (x-jito-auth).
JITO_AUTH_KEY=
# Hard ceiling on the tip, in lamports. Not advisory — without it a congestion
# spike or a malformed tip-floor response could spend an unbounded amount of SOL
# per trade, and the tip counts against position P&L. Default 5000000 (0.005 SOL).
JITO_MAX_TIP_LAMPORTS=5000000
# Used when the block engine's tip floor is unreadable. Default 100000.
JITO_FALLBACK_TIP_LAMPORTS=100000
# Tip floor percentile to target: p50 | p75 | p95. Higher lands more reliably
# and costs more. Default p75.
JITO_TIP_PERCENTILE=p75
# How long a submitted bundle stays pending before the sweep calls it ambiguous.
# Minimum 60000. Default 600000.
JITO_PENDING_TTL_MS=600000
JITO_TIMEOUT_MS=10000

# ── Trading Configuration ─────────────────────────────────────────────────────
# Used by: apps/trade-executor, apps/api (/v1/trading/status)

# Exact, case-sensitive modes: off, paper, live, live+shadow.
# Precedence is database execution_config, chain-specific value, global value,
# then paper. Keep per-chain overrides commented to inherit TRADING_MODE.
TRADING_MODE=paper
# TRADING_MODE_SOLANA=paper
# TRADING_MODE_POLYGON=paper
# TRADING_MODE_ROBINHOOD_CHAIN=paper

# Comma-separated operator allowlist. A live/live+shadow request remains paper
# unless the chain is listed here AND has an active reviewed certification row.
LIVE_ENABLED_CHAINS=

# Abort a Trojan request after this many milliseconds. Retried jobs reuse the
# signal ID as their idempotency key.
TROJAN_TIMEOUT_MS=15000

# Master switch for automatic trade execution.
# ⚠️ Keep false until signal quality is validated over 2+ weeks.
# Used by: apps/trade-executor
AUTO_EXECUTE=false

# Minimum signal score (0–100) to trigger an automatic trade.
# Manual execution via /v1/signals/:id/execute ignores this threshold.
# Used by: apps/trade-executor
AUTO_EXECUTE_MIN_SCORE=85

# Base trade size in SOL before tier × score multipliers are applied.
# Final size = BASE_POSITION_SOL × tier_multiplier × score_multiplier
#   elite×score≥90  → 1.0 × 1.0 × base = full base
#   promising×score≥80 → 0.5 × 0.75 × base = 37.5% of base
# Used by: apps/trade-executor, apps/alert-service (suggested execution display)
BASE_POSITION_SOL=0.5
MAX_POSITION_SOL=5

# Paper sizing inputs. PAPER_MAX_POSITION_PCT is intentionally omitted by
# default: Solana falls back to 5%, while EVM chains use their risk percentage.
PAPER_BANKROLL_USD=10000
# PAPER_MAX_POSITION_PCT=5

# Current executor-wide daily cap. Risk-policy consolidation remains tracked in
# the audit checklist; do not treat this as a per-chain certified risk policy.
DAILY_EXPOSURE_CAP_USD=50000

# ── Copy Eligibility ──────────────────────────────────────────────────────────
# Enforced at the canonical claim boundary, before a signal is claimed for
# execution. Re-checks source selection at execution time, because the nightly
# scorer sweep can pause a wallet after the signal-engine emitted its signal.
# A stop-loss carries no source trade and is never gated here — an exit must
# stay possible after its source wallet has been dropped.
# Used by: apps/trade-executor
#
# Tolerance for an indexer clock running ahead of ours.
COPY_MAX_CLOCK_SKEW_MS=30000
# Confirmed USD the source wallet must have traded in the lookback window.
# 0 disables the floor: notional is strategy-dependent, so it is opt-in.
COPY_MIN_SOURCE_ACTIVITY_USD=0
# Lifetime recorded trades the source wallet must have. Below this, any score it
# carries is an artifact of a tiny sample.
COPY_MIN_SOURCE_TRADES=3
# Window over which COPY_MIN_SOURCE_ACTIVITY_USD is measured (default 30 days).
COPY_ACTIVITY_LOOKBACK_MS=2592000000

# ── Signal Quality ────────────────────────────────────────────────────────────
# Signals with score below this threshold are logged to DB but NOT alerted.
# (Telegram alert is suppressed, trade queue is not touched)
# Used by: apps/signal-engine
MIN_SIGNAL_SCORE=70

# Shared external-request timeouts.
PRICE_FETCH_TIMEOUT_MS=8000

# ── Service Startup Flags ─────────────────────────────────────────────────────
# Set to 'true' on the scorer and/or discovery service to run the batch
# immediately on startup instead of waiting for the 02:00/02:30 UTC cron.
# Useful for: first-run seeding, manual batch triggers.
# Used by: apps/scorer, apps/discovery
RUN_ON_STARTUP=false

# ── Wallet Seeding ────────────────────────────────────────────────────────────
# Optional: comma-separated wallets to ingest on indexer start. Bare entries
# default to Solana; EVM entries must use polygon: or robinhood-chain: prefixes.
# Alternatively use the API: POST /v1/discovery/from-token or POST /v1/wallets
# Used by: apps/indexer/src/index.ts
WALLET_ADDRESSES=

# Optional starter-pack ingestion defaults. Entries may also be objects with
# their own `chain`, or strings prefixed with `solana:`, `polygon:`, or
# `robinhood-chain:`. Invalid/mismatched addresses fail before any DB write.
WALLET_CHAIN=solana
STARTER_PACK_PATH=wallet-starter-pack.json

# Bounded Helius history used by discover-starter-pack.ts. The discoverer skips
# launch/funder claims when it cannot reach the account origin within the cap.
DEX_CHAIN_ID=solana
STARTER_LAUNCH_WINDOW_TXS=50
STARTER_LAUNCH_SIGNATURE_CAP=20000
STARTER_WALLET_SIGNATURE_LIMIT=30
STARTER_FUNDER_SIGNATURE_CAP=5000
STARTER_FUNDER_TX_SCAN_LIMIT=50

# Parameters for token-based wallet discovery. Controls how far back to look
# when determining early and large buyers.
TOKEN_DISCOVERY_WINDOW=5000
TOKEN_DISCOVERY_MAX_TOTAL_SIGNATURES=20000
EARLY_BUYER_SLOTS=40
BIG_BUYER_SLOTS=10

# ── EVM & Multi-Chain Configuration ───────────────────────────────────────────
# RPC URLs. These explicit values match the runtime fallbacks; do not leave them
# blank because URL consumers distinguish an empty string from an unset value.
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Robinhood Chain Uniswap V3 quoter override.
ROBINHOOD_QUOTER_V2=0x61fFE014bA17989E743c5F6cB21bF9697530B21e

# Private Key for live trading on EVM chains (Polymarket CLOB & Robinhood Uniswap V3)
# Keep empty to run in paper trading mode or simulated EVM execution
EVM_PRIVATE_KEY=

# Polymarket CLOB V2 identity. EOA uses the signer as funder; proxy, Safe, and
# EIP-1271 modes require the account wallet in POLYMARKET_FUNDER_ADDRESS.
POLYMARKET_SIGNATURE_TYPE=EOA
POLYMARKET_FUNDER_ADDRESS=

# Optional persisted CLOB L2 credentials. Configure all three together. When all
# are empty, startup derives credentials with one L1 signature and keeps them only
# in process memory. These values are secrets and must never be exposed client-side.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Required registered bytes32 code (0x + 64 hex chars). It is embedded in every
# signed V2 order. Maker/taker fee rates are configured in the Builder profile.
POLYMARKET_BUILDER_CODE=

# Optional Builder API credentials used to add POLY_BUILDER_* authentication
# headers. Configure all three together. They are separate from CLOB L2 account
# credentials; the signed builder code above remains required for attribution.
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_API_SECRET=
POLYMARKET_BUILDER_API_PASSPHRASE=

# pUSD readiness uses six-decimal base units internally. The allowance cap is
# expanded by the fee buffer before exact approvals are submitted.
POLYMARKET_MIN_PUSD_BALANCE_USD=1
POLYMARKET_ALLOWANCE_CAP_USD=500
POLYMARKET_FEE_BUFFER_BPS=300

# Protected FAK order controls. Books older than the configured age are rejected;
# the depth walk must fit the slippage and price bounds before an order is signed.
POLYMARKET_MAX_BOOK_AGE_MS=15000
POLYMARKET_SLIPPAGE_BPS=200
POLYMARKET_MAX_ENTRY_PRICE=0.97
POLYMARKET_MIN_EXIT_PRICE=0.01
POLYMARKET_SETTLEMENT_TIMEOUT_MS=30000

# These flags can submit Polygon transactions at startup and are EOA-only.
# Proxy/Safe accounts must establish onramp and approvals through their wallet.
POLYMARKET_AUTO_ONRAMP=false
POLYMARKET_AUTO_APPROVE=false

# Sizing settings based on wallet balance
# If set to 'true', trades are sized as a percentage of the wallet's free balance (clamped by BASE/MAX boundaries)
USE_DYNAMIC_BALANCE_SIZING=false

# Percentage of free USDC to risk per Polymarket (Polygon) trade
USDC_BALANCE_RISK_PCT=2.0

# Percentage of free ETH to risk per Robinhood Chain trade
ETH_BALANCE_RISK_PCT=2.0

# Position limits for Polymarket (Polygon, sized in USDC)
BASE_POSITION_USDC=100
MAX_POSITION_USDC=500

# Position limits for Robinhood Chain (sized in ETH)
BASE_POSITION_ETH=0.05
MAX_POSITION_ETH=0.5
ROBINHOOD_GAS_RESERVE_ETH=0.005

# Cooldown window in minutes to prevent re-buying the same token/market
REBUY_COOLDOWN_MINUTES=60

# ── Indexer Tuning & Backfill ─────────────────────────────────────────────────
# EVM block backfill window size (number of blocks)
EVM_BACKFILL_BLOCKS=100000
EVM_LOG_CHUNK_SIZE=2000

# Signature/transaction batch limit per indexer loop
BACKFILL_BATCH_SIZE=5
BACKFILL_SIGNATURE_LIMIT=1000
BACKFILL_CONCURRENCY=1

# Helius RPC connection settings
HELIUS_RPC_TIMEOUT_MS=15000
HELIUS_MAX_RETRIES=5
