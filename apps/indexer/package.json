{
  "name": "@swat/indexer",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file=../../.env --import tsx/esm src/webhook.ts & tsx --env-file=../../.env --import tsx/esm src/index.ts",
    "dev:worker": "tsx src/index.ts",
    "dev:webhook": "tsx src/webhook.ts",
    "acceptance:g0-d11": "tsx --env-file=../../.env ../../scripts/g0-d11-acceptance.ts",
    "acceptance:polymarket-context": "tsx --env-file=../../.env ../../scripts/polymarket-context-acceptance.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "acceptance:polymarket-book": "tsx --env-file=../../.env ../../scripts/polymarket-book-acceptance.ts"
  },
  "dependencies": {
    "@swat/db": "workspace:*",
    "@swat/shared": "workspace:*",
    "bullmq": "^5.52.1",
    "fastify": "^5.0.0",
    "ioredis": "^5.6.1",
    "viem": "^2.55.1"
  },
  "devDependencies": {
    "vitest": "^3.0.5"
  }
}
