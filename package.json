{
  "name": "swat",
  "private": true,
  "packageManager": "pnpm@10.2.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && pnpm typecheck:tools && tsc --noEmit -p tsconfig.integration.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "db:migrate": "pnpm --filter @swat/db migrate",
    "acceptance:g0-d11": "pnpm --filter @swat/indexer acceptance:g0-d11",
    "acceptance:polymarket-context": "pnpm --filter @swat/indexer acceptance:polymarket-context",
    "dev:api": "pnpm --filter @swat/api dev",
    "dev:indexer": "pnpm --filter @swat/indexer dev",
    "dev:signals": "pnpm --filter @swat/signal-engine dev",
    "dev:alerts": "pnpm --filter @swat/alert-service dev",
    "dev:web": "pnpm --filter @swat/web dev",
    "dev:trade": "pnpm --filter @swat/trade-executor dev",
    "dev:scorer": "pnpm --filter @swat/scorer dev",
    "dev:discovery": "pnpm --filter @swat/discovery dev",
    "dev:mcp": "pnpm --filter @swat/mcp-server dev",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "check:secrets": "node scripts/check-public-secrets.mjs",
    "check:env": "node scripts/check-env-coverage.mjs",
    "seed:admin": "pnpm --filter @swat/db seed:admin",
    "acceptance:polymarket-book": "pnpm --filter @swat/indexer acceptance:polymarket-book"
  },
  "devDependencies": {
    "@fastify/cookie": "^11.1.2",
    "@swat/shared": "workspace:*",
    "@types/node": "^22.15.17",
    "bullmq": "^5.52.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "ioredis": "^5.6.1",
    "tsx": "^4.19.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
