# pattern_ml runs fully self-contained. It NEVER writes to the SWAT Postgres.
# Copy to .env and fill in. If a value is absent here, the loader falls back to
# the repo-root ../.env so you don't have to duplicate the Helius key.

# --- Solana sourcing (Helius) ---
HELIUS_API_KEY=

# --- Polymarket sourcing ---
# The Data API is public and needs no key. Override only to point at a proxy.
POLYMARKET_DATA_API=https://data-api.polymarket.com

# --- Local storage (all paths relative to pattern-ml/) ---
PATTERN_ML_DATA_DIR=data
PATTERN_ML_DB=data/warehouse.duckdb

# --- Sourcing throughput ---
# Helius free tier is ~10 rps; paid plans far more. Tune to your plan.
SOLANA_MAX_RPS=8
POLYMARKET_MAX_RPS=15
SOURCE_CONCURRENCY=4

# --- HTTP service (optional) ---
# Required when NODE_ENV/ENV is production; the service refuses to boot without it.
PATTERN_ML_API_KEY=
